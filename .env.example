# Schema Platform API Docs 配置示例
# 复制此文件为 .env 并填入实际值

# 服务器域名（用于线上环境配置）
VITE_SERVER_DOMAIN=https://your-domain.com

# 各项目的线上环境路径
VITE_SCHEMA_PLATFORM_PATH=/schema-platform
VITE_SALARY_PATH=/salary
VITE_AMBER_OF_TIME_PATH=/amber-of-time
VITE_INSPIRATION_PATH=/
VITE_MATRIX_APP_PATH=/matrix-app/api
VITE_STOCK_ANALYSIS_PATH=/stock-analysis